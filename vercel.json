{
  "rewrites": [
    { "source": "/ativar", "destination": "/ativar.html" },
    { "source": "/esqueci-senha", "destination": "/esqueci-senha.html" },
    { "source": "/redefinir-senha", "destination": "/redefinir-senha.html" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
